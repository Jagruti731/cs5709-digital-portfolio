flowchart TB
  subgraph PAGES["pages/ (one per route, lazy loaded)"]
    home[Home] --- about[About] --- edu[Education] --- know[Knowledge]
    gal[Gallery] --- blog[Blog] --- msg[Contact]
    rd[Readme] --- srch[Search] --- dash[Dashboard]
  end
  subgraph FEATURES["features/ (logic in hooks, display in components)"]
    feed["feed/<br/>usePostFeed · PostForm · PostCard · SignInForm"]
    chat["chat/<br/>useChat · answers · Chat"]
    search["search/<br/>searchIndex · useSearch"]
    github["github/<br/>useGitHub · RepoList · RunList"]
    motion["motion/<br/>useScrollReveal · useFlip (GSAP)"]
    media["media/<br/>PictureGallery · VideoGallery"]
  end
  subgraph CORE["shared"]
    comps["components/<br/>Layout · Navbar · Section · Card · LoadState"]
    hooks["hooks/<br/>useContent · useStoredState"]
    store["store/<br/>content · posts · auth · github slices"]
    services["services/<br/>contentApi · postsApi · githubApi"]
    cfg["config/site.ts · types/content.ts"]
  end
  PAGES --> comps
  PAGES --> FEATURES
  PAGES --> hooks
  FEATURES --> store
  hooks --> store
  store --> services
  services --> data[("public/data/*.json")]
  services --> ghapi[("api.github.com")]
  services -.-> apisrv[("Express API")]
  FEATURES --> cfg
  services --> cfg

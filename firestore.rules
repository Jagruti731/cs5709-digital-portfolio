rules_version = '2';

// Security rules for the shared community feed and visitor lounge (CR-31).
// The web config in src/config/firebase.ts is public, so these rules are what
// actually protect the data. Firebase checks them on its servers for every request.
//
//  - Anyone may read (the feed is public, like the rest of the site).
//  - Writing needs a signed-in (anonymous) visitor, and the author id must be the
//    caller's own id, so nobody can post in someone else's name.
//  - Every field is checked: only known fields, string lengths, image type and size,
//    and the time must be the server's time, not one sent by the browser.
//  - A like may add or remove only the caller's own id; nothing else in a post changes.
//  - Comments and lounge messages cannot be edited; a post may be deleted by its author.
//  - Rate limiting (CR-58): every new post, comment or lounge message must be written in
//    one batch with the caller's limits/{uid} document, which records the server time of
//    their last write of that kind. The limits document refuses a new time until the
//    interval has passed: 30 s between posts, 10 s between comments, 3 s in the lounge.
//  - Moderation (CR-58): a visitor whose id has a document in admins/ may delete any post,
//    comment or lounge message. Nobody can write to admins/ from the site; an admin is
//    added only in the Firebase console.
//  - Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function limitsPath() {
      return /databases/$(database)/documents/limits/$(request.auth.uid);
    }

    // True when this same batch stamps the caller's limits document for this kind of write.
    function stamped(kind) {
      let after = getAfter(limitsPath()).data;
      return kind in after && after[kind] == request.time;
    }

    // A new limits document holds exactly one stamp.
    function firstStamp(kind) {
      return request.resource.data.keys().hasOnly([kind]) && request.resource.data.keys().size() == 1
        && newStamp(kind, null);
    }

    // An update changes exactly one stamp.
    function nextStamp(kind) {
      return request.resource.data.diff(resource.data).affectedKeys() == [kind].toSet()
        && newStamp(kind, resource.data);
    }

    // Seconds a visitor must wait between two writes of the same kind.
    function interval(kind) {
      return kind == 'post' ? 30 : (kind == 'comment' ? 10 : 3);
    }

    // The limits document may change one kind at a time, to the server time, after the interval.
    function newStamp(kind, before) {
      return request.resource.data[kind] == request.time
        && (before == null || !(kind in before) || before[kind] + duration.value(interval(kind), 's') <= request.time);
    }

    function text(value, max) {
      return value is string && value.size() >= 1 && value.size() <= max;
    }

    function ownedNew() {
      return signedIn() && request.resource.data.authorId == request.auth.uid;
    }

    function validImage(image) {
      return image == null
        || (image is string && image.size() <= 400000 && image.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }

    // Only the caller's own id is added to, or removed from, likedBy.
    function onlyOwnLike() {
      let before = resource.data.likedBy.toSet();
      let after = request.resource.data.likedBy.toSet();
      let me = [request.auth.uid].toSet();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() <= 10000
        && ((after.difference(before) == me && before.difference(after).size() == 0)
          || (before.difference(after) == me && after.difference(before).size() == 0));
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if ownedNew()
        && request.resource.data.keys().hasOnly(['author', 'authorId', 'content', 'image', 'createdAt', 'likedBy'])
        && request.resource.data.keys().hasAll(['author', 'authorId', 'content', 'image', 'createdAt', 'likedBy'])
        && text(request.resource.data.author, 40)
        && text(request.resource.data.content, 1000)
        && validImage(request.resource.data.image)
        && request.resource.data.createdAt == request.time
        && request.resource.data.likedBy == []
        && stamped('post');
      allow update: if signedIn() && onlyOwnLike();
      allow delete: if (signedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if ownedNew()
        && request.resource.data.keys().hasOnly(['postId', 'author', 'authorId', 'content', 'createdAt'])
        && request.resource.data.postId is string
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))
        && text(request.resource.data.author, 40)
        && text(request.resource.data.content, 400)
        && request.resource.data.createdAt == request.time
        && stamped('comment');
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /lounge/{messageId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromId', 'text', 't'])
        && request.resource.data.fromId == request.auth.uid
        && text(request.resource.data.from, 40)
        && text(request.resource.data.text, 1000)
        && request.resource.data.t == request.time
        && stamped('lounge');
      allow update: if false;
      allow delete: if isAdmin();
    }

    // One document per visitor: the server time of their last post, comment and lounge message.
    match /limits/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && (firstStamp('post') || firstStamp('comment') || firstStamp('lounge'));
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['post', 'comment', 'lounge'])
        && (nextStamp('post') || nextStamp('comment') || nextStamp('lounge'));
      allow delete: if false;
    }

    // Moderators. Read-only for the visitor it names, so the site can show the admin tools.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
